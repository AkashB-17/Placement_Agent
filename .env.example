# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AUTO_APPLY_THRESHOLD=80

# Local files (used when DATABASE_URL is empty)
SQLITE_PATH=./data/placement.db
CHROMA_PATH=./.chroma

# Supabase: Project Settings -> API Keys, and the "Connect" button for DATABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Session pooler URI (the direct connection is IPv6-only on the free tier):
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Offline demo only: treat every request as admin. Refused when DATABASE_URL is set.
DEV_AUTH_BYPASS=false

AUTO_APPLY_WITHDRAW_HOURS=0.1
AUTO_APPLY_MIN_WINDOW_MINUTES=1

