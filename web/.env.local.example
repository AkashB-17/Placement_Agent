# Copy to .env.local. These are browser-safe values (the publishable key is meant for clients).
# Never put SUPABASE_SECRET_KEY or DATABASE_URL here: anything NEXT_PUBLIC_ ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
